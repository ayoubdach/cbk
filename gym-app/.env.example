# Optional: change the HTTP port.
PORT=3000

# SQLite database file path. The default is gym-app/data/gym.db.
# Keep this file and the data/ folder private and backed up.
# DATABASE_PATH=./data/gym.db

# Business timezone used for dates and automated reminders.
GYM_TIMEZONE=Africa/Tunis
# Set true if running behind HTTPS; otherwise leave false for local HTTP.
COOKIE_SECURE=false

# Optional: configure SMTP to deliver reminder emails and promotional campaigns.
# Until configured, messages stay queued and will not be sent.
# SMTP_FROM must be verified with your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gym Dashboard <no-reply@example.com>"

# Public URL included in reminder emails. Update this when deploying to a VPS.
APP_URL=http://localhost:3000
